# Plantilla de credenciales de firma de release para Android.
#
# Copiá este archivo a `keystore.properties` (gitignored) y completá los valores
# reales. NUNCA commitees `keystore.properties` ni el keystore (`*.jks` /
# `*.keystore`): el repo no versiona secretos.
#
# Las variables de entorno tienen precedencia sobre este archivo:
#   PLAYBOOK_KEYSTORE_FILE, PLAYBOOK_KEYSTORE_PASSWORD,
#   PLAYBOOK_KEY_ALIAS, PLAYBOOK_KEY_PASSWORD
#
# `storeFile` puede ser absoluto o relativo a la raíz del repo.

storeFile=/ruta/absoluta/playbook-upload.jks
storePassword=CAMBIAR_POR_EL_PASSWORD_DEL_KEYSTORE
keyAlias=playbook-upload
keyPassword=CAMBIAR_POR_EL_PASSWORD_DE_LA_KEY
